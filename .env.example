# --- Supabase (placeholders — remplacer par les valeurs du projet) ---
# Sans ces deux variables (ou avec les placeholders ci-dessous), l'app
# fonctionne en MODE DÉMO : données fictives étiquetées DÉMO, aucune donnée
# réelle. Voir README.md — section « Mode démo / mode réel ».
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# --- Stripe (Module 5 : abonnements — MODE TEST UNIQUEMENT) ---
# Compte EXISTANT Ciza Group / CizaShop, en MODE TEST d'abord. Ne créez
# JAMAIS un nouveau compte Stripe. Une clé live (sk_live_…) est refusée
# par le code. Voir docs/stripe-test-setup.md pour les 6 prix à créer.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Identifiants des 6 prix test (3 plans × 2 grilles, montants §12) :
STRIPE_PRICE_AFRIQUE_STARTER=price_placeholder
STRIPE_PRICE_AFRIQUE_PRO=price_placeholder
STRIPE_PRICE_AFRIQUE_AGENCE=price_placeholder
STRIPE_PRICE_INTERNATIONALE_STARTER=price_placeholder
STRIPE_PRICE_INTERNATIONALE_PRO=price_placeholder
STRIPE_PRICE_INTERNATIONALE_AGENCE=price_placeholder

# --- Supabase service role (webhooks Stripe / mobile money uniquement) ---
# Serveur uniquement, jamais côté client. Sans elle, les webhooks accusent
# réception sans rien appliquer (aucune fausse activation).
SUPABASE_SERVICE_ROLE_KEY=service-role-placeholder

# --- WhatsApp Business Platform — API officielle Meta (Module 6) ---
# Serveur uniquement (jamais côté client, jamais en clair). Sans ces deux
# variables, AUCUN envoi WhatsApp n'est effectué : le statut affiché est
# « non configuré ». Voir docs/whatsapp-setup.md pour la création de
# l'application Meta, du numéro et du token.
# POINT OUVERT (choix du fondateur) : le numéro +1 514 502 9503 est utilisé
# en manuel dans l'application WhatsApp Business. Un numéro ne peut pas être
# à la fois dans l'appli et dans l'API : soit il est migré vers l'API, soit
# un autre numéro est utilisé pour les alertes automatiques.
WHATSAPP_API_TOKEN=whatsapp-api-token-placeholder
WHATSAPP_PHONE_NUMBER_ID=whatsapp-phone-number-id-placeholder

# --- Taux de change automatiques (Module 6) ---
# Service externe gratuit, sans clé : open.er-api.com (taux de référence
# de la BCE). Surcharger uniquement si un autre service est choisi.
TAUX_API_URL=https://open.er-api.com/v6/latest/USD

# --- Formulaire Contact / Démo (Module 7) ---
# Clé PUBLIQUE Web3Forms (alias d'e-mail, pas un secret) : la même que
# celle utilisée sur cizagroup.com et cizasupply.com. Sans elle, le
# formulaire Contact ne prétend pas envoyer : il bascule sur un lien
# mailto vers infos@cizagroup.com, avec le message déjà rédigé.
NEXT_PUBLIC_WEB3FORMS_KEY=web3forms-access-key-placeholder

# --- E-mails d'alerte (Module 4, optionnel) ---
# Fournisseur HTTP générique : POST {to, subject, text, html}.
# Sans ces deux variables, AUCUN e-mail n'est envoyé : l'interface
# affiche « e-mail non configuré » sur chaque alerte, sans simulation.
# (Resend, SendGrid, Mailgun… : renseigner l'URL et la clé du fournisseur
# choisi ; ne jamais mettre de clé en clair dans le dépôt.)
EMAIL_API_URL=
EMAIL_API_KEY=

